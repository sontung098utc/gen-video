APP_NAME="AI Short Video Generator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=genvideo_ai
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# CẤU HÌNH CỔNG AI SIÊU TIẾT KIỆM (COST-OPTIMIZED AI GATEWAY)
# ------------------------------------------------------------------------------

# 1. Google Gemini 3.8 Flash / 3.5 Flash Lite API (Free Tier - $0.00)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/models"
GEMINI_TIMEOUT_SECONDS=90

# 2. Microsoft Edge Neural TTS CLI (Chạy trực tiếp trên CentOS 8 - $0.00)
EDGE_TTS_BINARY="/usr/local/bin/edge-tts"
EDGE_TTS_DEFAULT_VOICE="vi-VN-NamMinhNeural"
EDGE_TTS_FEMALE_VOICE="vi-VN-HoaiMyNeural"
EDGE_TTS_DEFAULT_RATE="+5%"
EDGE_TTS_DEFAULT_PITCH="+0Hz"

# 3. Fal.ai Unified Gateway (1 FAL_KEY duy nhất cho Flux Schnell, LTX-Video, Trellis 3D)
FAL_KEY=""
FAL_BASE_URL="https://fal.run"
FAL_QUEUE_URL="https://queue.fal.run"
FAL_MODEL_FLUX_SCHNELL="fal-ai/flux/schnell"
FAL_MODEL_LTX_VIDEO="fal-ai/ltx-video/image-to-video"
FAL_MODEL_TRELLIS_3D="fal-ai/trellis"

# 4. Công cụ xử lý Media & 3D trên CentOS 8 (Giới hạn CPU bảo vệ LiteSpeed)
FFMPEG_BINARY="/usr/local/bin/ffmpeg"
FFPROBE_BINARY="/usr/local/bin/ffprobe"
FFMPEG_MAX_THREADS=6
FFMPEG_NICE_PRIORITY=10
PYTHON3_BINARY="/usr/bin/python3.11"
OMP_NUM_THREADS=6
ORT_NUM_THREADS=6
